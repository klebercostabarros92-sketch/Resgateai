    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.13.4",
    "@types/amqplib": "^0.10.4",
    "@types/speakeasy": "^2.0.10",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.3.3",
